.DS_Store

# Word lock/cache files
~$*

.claude/

# to_add/

# Logs from build scripts
logs/

# Intermediate build artifacts
build/
__pycache__/
*.pyc

# Workspace for hand-review (e.g. orphan PDF inspection)
tmp/

# Poppler's own extraction of transcribed pages, used only as a cross-check
# input. Derived from PDFs already in this repo; regenerate with
# `python3 transcriptions/scripts/crosscheck.py --regen-provenance`.
transcriptions/*/_provenance/
